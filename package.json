{
  "name": "weeljack-ng",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/dev.mjs",
    "build": "ng build weeljack-ng && node scripts/copy-package-files.mjs",
    "typecheck": "ngc -p projects/weeljack-ng/tsconfig.lib.json --noEmit && ngc -p projects/weeljack-ng/tsconfig.spec.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "ng test --watch=false",
    "test:watch": "ng test weeljack-ng",
    "test:debug": "ng test weeljack-ng --headless=false",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "check:contrast": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-contrast.mjs",
    "generate": "node scripts/extract-api.mjs && node scripts/extract-examples.mjs && node scripts/generate-registries.mjs",
    "build:docs": "npm run generate && ng build docs && node scripts/write-404.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "check:a11y": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-a11y.mjs",
    "size": "node scripts/size.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "pack:local": "npm run build && npm pack ./dist/weeljack-ng --pack-destination dist",
    "check": "npm run generate && npm run lint && npm run typecheck && npm run build && npm run check:contrast && npm run test && npm run build:docs && npm run check:ssr && npm run check:a11y && npm run size && npm run check:pack && npm run check:licences"
  },
  "devDependencies": {
    "@angular/build": "~22.2.6",
    "@angular/cdk": "~22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/common": "~22.2.6",
    "@angular/compiler": "~22.2.6",
    "@angular/compiler-cli": "~22.2.6",
    "@angular/core": "~22.2.6",
    "@angular/forms": "~22.2.6",
    "@angular/platform-browser": "~22.2.6",
    "@angular/platform-server": "~22.2.6",
    "@angular/router": "~22.2.6",
    "@angular/ssr": "~22.2.6",
    "@openng/optimus-ui": "~2.0.2",
    "@openng/optimus-ui-locale": "~2.0.2",
    "@openng/optimus-ui-themes": "~2.0.2",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^5.1.0",
    "angular-eslint": "^22.0.0",
    "axe-core": "^4.10.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "ng-packagr": "~22.2.6",
    "playwright": "^1.65.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
