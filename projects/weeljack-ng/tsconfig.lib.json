{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "rewriteRelativeImportExtensions": true,
    "types": [],
    "paths": {
      "weeljack-ng": ["./src/public-api.ts"],
      "weeljack-ng/*": ["./*/public-api.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "spec-support/**", "node_modules"]
}
